# Copia este fichero como .env y rellena lo que necesites.

# Base de datos PostgreSQL 15+ (el esquema "vigilante" se crea con: node bin/vigilante.js migrar)
DATABASE_URL=postgres://usuario:clave@localhost:5432/vigilante

# Triaje y análisis con Claude (sin clave, el vigilante funciona pero no tría)
ANTHROPIC_API_KEY=
# VIGILANTE_MODELO=claude-opus-5-5
# VIGILANTE_ESFUERZO=low           # esfuerzo del triaje: low | medium | high
# VIGILANTE_TRIAJE_LOTE=40         # convocatorias por pasada de triaje
# VIGILANTE_PERFIL=config/perfil-empresa.md

# Vigilancia
# VIGILANTE_FUENTES=BDNS,BOE,PLACE,TED
# VIGILANTE_DIAS=3                 # días hacia atrás que se revisan en cada pasada
# VIGILANTE_RELEVANCIA_MINIMA=baja # baja | media | alta: por debajo no se guarda
# VIGILANTE_PLACSP_MAX_PAGINAS=20
# VIGILANTE_TED_MAX_PAGINAS=5
# VIGILANTE_BDNS_MAX_PAGINAS=40
# VIGILANTE_ZONA=Europe/Madrid

# Servidor web
# VIGILANTE_HOST=127.0.0.1         # pon 0.0.0.0 solo detrás de un proxy con HTTPS
# VIGILANTE_PUERTO=3080
# VIGILANTE_TOKEN=                 # si lo defines, la web y la API lo piden

# Clientes
# VIGILANTE_ENCAJE_LOTE=60          # cruces cliente-convocatoria que evalúa Claude por tanda
# VIGILANTE_DIAS_RASTREO=90         # días que relee "Buscar en las fuentes" para un cliente nuevo
# VIGILANTE_RASTREO_MAX_PAGINAS=1000

# Correo (avisos de oportunidades de clientes y búsquedas guardadas).
# Con Gmail: crea una "contraseña de aplicación" en myaccount.google.com/apppasswords
# (requiere la verificación en dos pasos) y pégala en SMTP_PASS, sin espacios.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=
# SMTP_FROM=Radar Financiación - Islaris <tu_correo@gmail.com>
# VIGILANTE_EMAIL_AVISOS=tu_correo@gmail.com   # a quién llegan los avisos (por defecto, SMTP_USER)
